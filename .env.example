# ==============================================================================
# HemaCare Production & Development Environment Configuration Template
# ==============================================================================

# Core Application Settings
NODE_ENV=development # Options: 'development' | 'production' | 'test'
PORT=5000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/blood_donation_db?schema=public"

# Authentication & Security
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=de6d653ca3174c6c82f233821134c9220c0137e6b3f1a81b316f00456b3129ce
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Initial Administrator Bootstrap Credentials
ADMIN_EMAIL=admin@blooddonation.org
ADMIN_PASSWORD=AdminSecurePass123!

# ==============================================================================
# External Notification Providers (Phase 14 Production Infrastructure)
# ==============================================================================

# Email Provider Configuration ('mock' | 'resend' | 'sendgrid' | 'smtp')
EMAIL_PROVIDER=mock
EMAIL_FROM="HemaCare Transfusion Registry <alerts@blooddonation.org>"
# EMAIL_API_KEY=re_1234567890abcdef (Required if EMAIL_PROVIDER is resend or sendgrid)

# SMS Provider Configuration ('mock' | 'twilio' | 'generic')
SMS_PROVIDER=mock
# SMS_FROM=+15551234567
# SMS_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# SMS_AUTH_TOKEN=your_twilio_auth_token

# ==============================================================================
# Observability & Error Monitoring
# ==============================================================================
LOG_LEVEL=info # Options: 'debug' | 'info' | 'warn' | 'error'
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
