datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  DONOR
  ADMIN
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
}

enum RequestUrgency {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum RequestStatus {
  OPEN
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
  EXPIRED
}

enum OpportunityStatus {
  PENDING
  VIEWED
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
  FULFILLED
}

enum DeclineReason {
  NOT_AVAILABLE
  CANNOT_TRAVEL
  RECENTLY_DONATED
  OTHER
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
}

enum NotificationType {
  OPPORTUNITY_ALERT
  STATUS_UPDATE
  GENERAL
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  passwordHash        String
  role                Role                 @default(DONOR)
  sessionVersion      Int                  @default(1)
  donorProfile        DonorProfile?
  bloodRequests       BloodRequest[]
  notifications       Notification[]
  passwordResetTokens PasswordResetToken[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([email])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model DonorProfile {
  id             String             @id @default(uuid())
  userId         String             @unique
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName       String
  dateOfBirth    DateTime
  address        String
  contactNumber  String
  bloodGroup     BloodGroup
  lastDonationAt DateTime?
  preferences    Json?              @default("{}")
  deletedAt      DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  donations      Donation[]
  opportunities  DonorOpportunity[]

  @@index([bloodGroup])
  @@index([contactNumber])
  @@index([deletedAt])
}

model BloodRequest {
  id               String             @id @default(uuid())
  createdById      String
  createdBy        User               @relation(fields: [createdById], references: [id])
  bloodGroup       BloodGroup
  unitsRequired    Int
  unitsFulfilled   Int                @default(0)
  urgency          RequestUrgency     @default(NORMAL)
  location         String
  requiredBy       DateTime
  patientReference String?
  hospitalName     String
  status           RequestStatus      @default(OPEN)
  notes            String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  donations        Donation[]
  opportunities    DonorOpportunity[]

  @@index([bloodGroup, status])
  @@index([status])
  @@index([urgency])
  @@index([requiredBy])
  @@index([createdAt])
}

model DonorOpportunity {
  id             String            @id @default(uuid())
  donorId        String
  donor          DonorProfile      @relation(fields: [donorId], references: [id], onDelete: Cascade)
  bloodRequestId String
  bloodRequest   BloodRequest      @relation(fields: [bloodRequestId], references: [id], onDelete: Cascade)
  matchScore     Int
  matchReason    String
  status         OpportunityStatus @default(PENDING)
  declineReason  DeclineReason?
  declineNotes   String?
  expiresAt      DateTime
  viewedAt       DateTime?
  respondedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  notifications  Notification[]

  @@index([donorId, status])
  @@index([bloodRequestId, status])
  @@index([expiresAt])
  @@index([createdAt])
}

model Notification {
  id                String              @id @default(uuid())
  userId            String
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunityId     String?
  opportunity       DonorOpportunity?   @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  channel           NotificationChannel @default(IN_APP)
  type              NotificationType    @default(OPPORTUNITY_ALERT)
  status            NotificationStatus  @default(PENDING)
  title             String
  message           String
  attemptCount      Int                 @default(0)
  lastAttemptAt     DateTime?
  failedAt          DateTime?
  errorCode         String?
  providerMessageId String?
  idempotencyKey    String?             @unique
  sentAt            DateTime?
  readAt            DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @default(now()) @updatedAt

  @@index([userId, status])
  @@index([status, channel])
  @@index([opportunityId])
  @@index([createdAt])
}

model Donation {
  id             String        @id @default(uuid())
  donorId        String
  donor          DonorProfile  @relation(fields: [donorId], references: [id], onDelete: Cascade)
  bloodRequestId String?
  bloodRequest   BloodRequest? @relation(fields: [bloodRequestId], references: [id], onDelete: SetNull)
  donatedAt      DateTime      @default(now())
  location       String
  notes          String?
  createdAt      DateTime      @default(now())

  @@index([donorId])
  @@index([bloodRequestId])
  @@index([donatedAt])
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  action      String
  targetType  String
  targetId    String?
  metadata    Json?    @default("{}")
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([actorUserId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
}
